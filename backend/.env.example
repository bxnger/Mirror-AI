# PostgreSQL (docker-compose sets this automatically for the api service).
# Without it the app falls back to a local SQLite file: sqlite:///./mirror_ai.db
DATABASE_URL=postgresql+psycopg://mirror:mirror@localhost:5432/mirror_ai
# host port for `docker compose` (the api container always listens on 8000 inside)
MIRROR_PORT=8000

# LLM explanations in What If Lab (Claude). Without a key the app uses template explanations.
ANTHROPIC_API_KEY=
# auto | on | off
MIRROR_LLM=auto
MIRROR_LLM_MODEL=claude-opus-5-5
# low | medium | high
MIRROR_LLM_EFFORT=medium
MIRROR_LLM_TIMEOUT=90
